# Caddy del entorno de prueba local (docker-compose.local.yml).
:8080 {
	# Archivos públicos: /img/grupo06-frenet-lagrange/<clave>  →  SeaweedFS /grupo06-frenet-lagrange-imgs/<clave>
	handle_path /img/grupo06-frenet-lagrange/* {
		rewrite * /grupo06-frenet-lagrange-imgs{path}
		reverse_proxy seaweedfs:8333
	}

	# Endpoint MCP del grupo 06: /grupo06/grupo06_proyecto01_frenet-lagrange/mcp  →  grupo06-frenet-lagrange:8000/mcp
	handle_path /grupo06/grupo06_proyecto01_frenet-lagrange/* {
		reverse_proxy grupo06-frenet-lagrange:8000 {
			flush_interval -1     # MCP responde con streaming (SSE): no acumular en búfer
		}
	}
}
