# EJEMPLO de las rutas que el Caddy del laboratorio necesita para este servicio.
# (El Caddyfile real lo administra el profesor; adapta los nombres si su convención es otra.)
rac-unmsm.vekthos.org {
	# 1) Archivos públicos (reportes HTML, PNG, JSON) desde SeaweedFS:
	#    https://rac-unmsm.vekthos.org/img/frenet-lagrange/grupo06/<id>/reporte.html
	handle_path /img/frenet-lagrange/* {
		rewrite * /frenet-lagrange-imgs{path}
		reverse_proxy seaweedfs:8333
	}

	# 2) Endpoint MCP (streamable-http) del grupo 06:
	#    https://rac-unmsm.vekthos.org/grupo06/frenet-lagrange/mcp
	handle_path /grupo06/frenet-lagrange/* {
		reverse_proxy grupo06-frenet-lagrange:8000 {
			flush_interval -1
		}
	}
}
