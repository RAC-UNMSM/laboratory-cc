 y^{1−n} y factor integrante", "tratamiento": ["analitico", "numerico"], "balotario": ["1.2"], "clasificacion": {"familia": "bernoulli", "nombre": "Ecuación de Bernoulli", "tema": "Tema 1 · EDOs lineales y no lineales", "balotario": ["1.2"], "compatibles": ["bernoulli"], "motivo": "El enunciado pide el método: Ecuación de Bernoulli.", "fuera_de_alcance": null, "metodo_rechazado": null}, "secciones": [{"clave": "clasificacion", "titulo": "Planteamiento y clasificación", "bloques": [{"tipo": "formula", "latex": "y' = x^{2} y^{3} - \\frac{2 y}{x}"}, {"tipo": "texto", "texto": "El enunciado pide el método: Ecuación de Bernoulli."}]}, {"clave": "identificacion", "titulo": "Identificación de la ecuación de Bernoulli", "bloques": [{"tipo": "formula", "latex": "y' + P(x)y = Q(x)y^{n}", "destacada": true}, {"tipo": "formula", "latex": "y' + \\frac{2}{x}\\, y = x^{2}\\, y^{3}"}, {"tipo": "formula", "latex": "P(x) = \\frac{2}{x},\\qquad Q(x) = x^{2},\\qquad n = 3"}]}, {"clave": "cambio_de_variable", "titulo": "Cambio de variable $v = y^{1-n}$", "bloques": [{"tipo": "formula", "latex": "v = y^{1-n} = \\frac{1}{y^{2}}", "destacada": true, "ref": "sustitucion"}, {"tipo": "formula", "latex": "\\frac{dv}{dx} = - \\frac{2}{y^{3}} \\frac{dy}{dx}"}, {"tipo": "formula", "latex": "v' = - \\frac{2}{y^{3}} y'", "texto": "v' = (-2/y**3)*y'", "destacada": true}, {"tipo": "formula", "latex": "\\frac{y'}{y^{3}} = - \\frac{v'}{2}", "texto": "y'/y**3 = -v'/2"}]}, {"clave": "division", "titulo": "División de la ecuación entre $y^{3}$", "bloques": [{"tipo": "formula", "latex": "y' + \\frac{2}{x}\\, y = x^{2}\\, y^{3}"}, {"tipo": "formula", "latex": "\\frac{1}{y^{3}}\\, y' + \\frac{2}{x}\\, \\frac{1}{y^{2}} = x^{2}"}, {"tipo": "formula", "latex": "\\frac{y'}{y^{3}} = - \\frac{v'}{2} ,\\qquad \\frac{1}{y^{2}} = v"}, {"tipo": "formula", "latex": "\\frac{2 v}{x} - \\frac{v'}{2} = x^{2}", "texto": "2*v/x - v'/2 = x**2"}]}, {"clave": "ecuacion_lineal", "titulo": "Ecuación lineal en $v$", "bloques": [{"